# Adhara Fit — variables de entorno. Copia este archivo a .env y completa los valores.
# Aquí no va ningún secreto: los valores reales viven solo en tu .env (ignorado por git).

# Base de datos
DATABASE_URL=
DATABASE_URL_LOCAL=

# Almacenamiento de archivos (Cloudflare R2 / S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Kiosco de check-in
NEXT_PUBLIC_API_URL=
KIOSCO_URL=
KIOSCO_CLAVE=

# Vitrina de TV
VITRINA_WEB_DIR=

# Entorno de ejecución (lo fija el Dockerfile en producción)
NODE_ENV=

# --- Solo Compose (solo local): valores de desarrollo de PostgreSQL para docker compose ---
POSTGRES_USER=adhara
POSTGRES_PASSWORD=adhara_local
POSTGRES_DB=adhara
