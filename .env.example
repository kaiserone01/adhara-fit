# Adhara Fit — variables de entorno. Copia este archivo a .env y completa los valores.
# Aquí no va ningún secreto: los valores reales viven solo en tu .env (ignorado por git).

# Base de datos
DATABASE_URL=
DATABASE_URL_LOCAL=

# Almacenamiento de archivos (Cloudflare R2 / S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Check-in Module (APK de Android TV)
NEXT_PUBLIC_API_URL=
CHECKIN_URL=
# Clave única del Check-in Module (mínimo 16 caracteres, sin valor aquí). La usan web-admin (la valida) y el APK (la lleva dentro).
CHECKIN_CLAVE=

# Vitrina de TV
VITRINA_WEB_DIR=

# Primer administrador (S-15): solo se leen si todavía no existe ninguno. Sin ADMIN_CONTRASENA_INICIAL se genera una
# de 20 caracteres y se imprime una sola vez en el registro del arranque.
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_CONTRASENA_INICIAL=

# Entorno de ejecución (lo fija el Dockerfile en producción)
NODE_ENV=

# --- Solo Compose (solo local): valores de desarrollo de PostgreSQL para docker compose ---
POSTGRES_USER=adhara
POSTGRES_PASSWORD=adhara_local
POSTGRES_DB=adhara
