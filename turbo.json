{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "checkin#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "vitrina#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
